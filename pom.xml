<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================================
         Parent: Spring Boot BOM (Bill of Materials)
         This gives every child module access to Spring Boot's managed
         dependency versions without you having to specify them manually.
    ===================================================================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.1</version>
        <relativePath/>
    </parent>

    <!-- =====================================================================
         Project coordinates — every child module will inherit groupId
         and version from here.
    ===================================================================== -->
    <groupId>com.streamcart</groupId>
    <artifactId>streamcart</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>StreamCart</name>
    <description>
        Microservices e-commerce platform for learning backend fundamentals:
        REST, gRPC, Kafka, RabbitMQ, Redis, PostgreSQL, MongoDB, Docker, JWT.
    </description>

    <!-- =====================================================================
         Child modules — Maven will look for a pom.xml inside each folder.
    ===================================================================== -->
    <modules>
        <module>api-gateway</module>
        <module>user-service</module>
        <module>product-service</module>
        <module>order-service</module>
        <module>notification-service</module>
    </modules>

    <!-- =====================================================================
         Java version — all modules compile with Java 21.
    ===================================================================== -->
    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2023.0.2</spring-cloud.version>
    </properties>

    <!-- =====================================================================
         Dependency Management — versions declared here are inherited by all
         child modules. A child only needs to declare the groupId+artifactId,
         the version is resolved from here automatically.
    ===================================================================== -->
    <dependencyManagement>
        <dependencies>

            <!-- Spring Cloud BOM (API Gateway, service discovery, etc.) -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- =====================================================================
         Build plugins shared by all modules.
    ===================================================================== -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
